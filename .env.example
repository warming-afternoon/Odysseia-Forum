# ============================================================
# Odysseia-Forum 环境变量配置
# 复制此文件为 .env 并填入实际值
# ============================================================

# ── Discord 机器人 Token ──────────────────────────────
BOT_TOKEN=在此填入你的 Discord 机器人 Token

# ── 认证查询辅助 Bot Token（可选，多个使用逗号分隔） ──
AUTH_BOT_TOKENS=

# ── DeepSeek 更新检测 API Key（active 模式必填）──────────
DEEPSEEK_API_KEY=

# ── PostgreSQL 数据库密码 （可选）────────────────────────────────
# 本地开发或非 Docker 部署时使用，Docker 部署默认 changeme
# PG_PASSWORD=在此填入你的密码

# ── 数据库连接 URL（可选，docker-compose 已自动注入）─────
# 本地开发或非 Docker 部署时使用，Docker 部署无需设置
# DATABASE_URL=postgresql+asyncpg://odysseia:你的密码@localhost:5432/odysseia

# ── 数据库连接池（可选）────────────────────────────────
# Bot 默认 5+8、等待 30 秒；docker-compose 已单独为 API 设置为 6+12、等待 5 秒
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=8
# DB_POOL_TIMEOUT=30


# ── Redis 连接 URL（可选，docker-compose 已自动注入）─────────
# 本地开发或非 Docker 部署时使用，Docker 部署无需设置
# REDIS_URL=redis://:你的密码@localhost:6379/0

# ── 备份加密密钥（可选）────────────────────────────────
# 用于加密备份到 S3 的 config.json 和 .env。生成方式：
#   python3 -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
# BACKUP_ENCRYPTION_KEY=

# 显式启用统一身份；完成 prepare、权威导入、回填审计与 runtime 迁移后才切换
FORUM_AUTH_MODE=legacy
# 后端使用的 Fluxer 集成基址；不要将其作为浏览器公开地址
FLUXER_API_URL=https://fluxer.example/api
# 浏览器访问的 Fluxer 公网 API 基址，必须使用 HTTPS
FLUXER_PUBLIC_API_URL=
INTEGRATION_NATS_URL=nats://nats:4222
INTEGRATION_NATS_USER=forum-service
INTEGRATION_NATS_PASSWORD=

# V1/V2兼容灰度；V2关闭时不注册可访问功能或启动新消费者
FORUM_V2_ENABLED=false
# 自部署站点，来源链接使用此origin
FLUXER_WEB_URL=https://fluxer.example
# 必须在Discord控制台单独登记，Cookie限于/v2/auth
FORUM_V2_DISCORD_REDIRECT_URI=https://forum.example/v2/auth/callback
INTEGRATION_CONTENT_STREAM=ODYSSEIA_CONTENT
INTEGRATION_CONTENT_CONSUMER=forum-index
INTEGRATION_AUTH_STREAM=ODYSSEIA_AUTH
INTEGRATION_AUTH_CONSUMER=forum-auth

# 增长统计接受与保留窗口：过期活动拒收，快照不补造历史增长。
WORK_GROWTH_ACCEPT_DAYS=90
WORK_GROWTH_RECEIPT_DAYS=120
WORK_GROWTH_PAYLOAD_DAYS=7
# 静默校准是近似边界，不保证源端延迟或时钟偏差下无损。
WORK_GROWTH_QUIET_SECONDS=120
# 每分钟每类最多执行的 2000 行清理批次，积压会输出 growth_cleanup_lag。
WORK_GROWTH_CLEANUP_BATCHES=10
# 历史统计重建/修复须在同事务先执行 SET LOCAL odysseia.growth_rebaseline = 'on';
# 该模式只用于受控维护，不得用于普通收藏、反应或回复业务事务。

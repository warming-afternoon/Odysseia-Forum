# ============================================================
# Odysseia-Forum 环境变量配置
# 复制此文件为 .env 并填入实际值
# ============================================================

# ── Discord 机器人 Token ──────────────────────────────
BOT_TOKEN=在此填入你的 Discord 机器人 Token

# ── PostgreSQL 数据库密码 （可选）────────────────────────────────
# 本地开发或非 Docker 部署时使用，Docker 部署默认 changeme
# PG_PASSWORD=在此填入你的密码

# ── 数据库连接 URL（可选，docker-compose 已自动注入）─────
# 本地开发或非 Docker 部署时使用，Docker 部署无需设置
# DATABASE_URL=postgresql+asyncpg://odysseia:你的密码@localhost:5432/odysseia


# ── Redis 连接 URL（可选，docker-compose 已自动注入）─────────
# 本地开发或非 Docker 部署时使用，Docker 部署无需设置
# REDIS_URL=redis://:你的密码@localhost:6379/0

# ── 备份加密密钥（可选）────────────────────────────────
# 用于加密备份到 S3 的 config.json 和 .env。生成方式：
#   python3 -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
# BACKUP_ENCRYPTION_KEY=